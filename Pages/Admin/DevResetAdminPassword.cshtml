@page
@model GraceThreads.Pages.Admin.DevResetAdminPasswordModel
@{
    ViewData["Title"] = "Dev Reset Admin Password";
}

<div class="max-w-xl mx-auto p-6 bg-white rounded shadow">
    <h2 class="text-xl font-bold mb-4">Development: Reset Admin Password</h2>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="mb-4 text-sm text-green-700">@Model.Message</div>
    }
    <form method="post">
        <label class="block text-sm font-medium">New Password</label>
        <input asp-for="NewPassword" class="mt-1 block w-full border rounded px-2 py-1" />
        <div class="mt-4">
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Set Password</button>
        </div>
    </form>
</div>