@page
@model GraceThreads.Pages.Admin.ProductsModel
@using GraceThreads.Services
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grace Threads — Admin Products</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        }

        body {
        background: #0c0c0c;
        }

        #admin-drawer, #edit-panel {
        transform: translateX(100%);
        transition: transform 0.3s ease;
        }

        #admin-drawer.open, #edit-panel.open {
        transform: translateX(0);
        }

        #admin-drawer-overlay, #edit-overlay {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        }

        #admin-drawer-overlay.open, #edit-overlay.open {
        opacity: 1;
        pointer-events: auto;
        }

        input:focus {
        outline: none;
        border-color: #f05a1a;
        }
    </style>
</head>
<body class="bg-[#0c0c0c] text-white">

    <div class="bg-[#f05a1a] text-white text-center py-2.5 px-4">
        <span class="text-[11px] font-bold tracking-wide">Free Shipping on All Orders Over $60 · Ephesians 2:8</span>
    </div>

    <header class="border-b border-white/10">
        <div class="max-w-7xl mx-auto h-16 flex items-center justify-between px-6">
            <a href="/Admin/Dashboard" class="flex items-center gap-3">
                <div class="w-[34px] h-[34px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-6 h-6 object-contain">
                </div>
                <div class="leading-tight">
                    <div class="font-black text-lg text-neutral-100">Grace Threads</div>
                    <div class="font-medium text-[9px] text-[#888888] tracking-wide">Admin</div>
                </div>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                <a href="/Home" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Home</a>
                <a href="/Catalog" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Shop</a>
            </nav>
            <div class="flex items-center gap-3">
                <a href="/Admin/Dashboard" class="border border-white/20 text-[10px] font-bold text-neutral-100 px-3 py-1.5">📊 Dashboard</a>
                <button onclick="toggleAdminDrawer()" class="w-8 h-8 rounded-full bg-[#f05a1a] flex items-center justify-center">
                    <span class="text-xs font-black text-white">A</span>
                </button>
            </div>
        </div>
    </header>

    <partial name="_AdminAccountDrawer" />

    <!-- Edit product panel -->
    <div id="edit-overlay" class="fixed inset-0 bg-black/60 z-40" onclick="closeEditPanel()"></div>
    <aside id="edit-panel" class="fixed top-0 right-0 h-full w-full max-w-[420px] bg-[#161616] z-50 flex flex-col border-l border-white/10 overflow-y-auto">
        <div class="flex justify-between items-center px-6 py-5 border-b border-white/10">
            <span id="edit-panel-title" class="font-black text-sm text-neutral-100">Edit Product</span>
            <button onclick="closeEditPanel()">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="#888888" stroke-width="2">
                    <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        <div class="px-6 py-5">
            <div class="w-full h-40 bg-[#1a1a1a] flex items-center justify-center overflow-hidden border border-white/5">
                <img id="edit-image-preview" src="" alt="" class="max-w-full max-h-full object-contain">
            </div>
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mt-4 p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-medium">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form method="post" asp-page-handler="Save" enctype="multipart/form-data" class="flex flex-col gap-4 mt-5">
                <input type="hidden" name="id" id="edit-id" />
                
                <div>
                    <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Upload Photo (Max 2MB)</label>
                    <input type="file" name="imageFile" id="edit-imageFile" accept="image/*" onchange="previewAndValidateFile(this)" class="w-full text-xs text-[#888888] file:mr-3 file:py-2 file:px-3 file:border-0 file:text-[10px] file:font-bold file:bg-white/10 file:text-white hover:file:bg-white/20 file:transition bg-[#222222] border border-white/10 h-11 flex items-center pr-2">
                    <p id="file-size-warning" class="text-red-400 text-[10px] font-medium mt-1 hidden">⚠️ This photo exceeds 2MB. Please compress it or pick a smaller file.</p>
                </div>

                <div>
                    <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Or Direct Image URL</label>
                    <input type="text" name="imageUrl" id="edit-imageUrl" class="w-full h-11 bg-[#222222] border border-white/10 px-3 text-sm text-white" oninput="document.getElementById('edit-image-preview').src = this.value">
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Product Name</label>
                    <input type="text" name="name" id="edit-name" class="w-full h-11 bg-[#222222] border border-white/10 px-3 text-sm text-white" required>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Variant</label>
                    <input type="text" name="variant" id="edit-variant" class="w-full h-11 bg-[#222222] border border-white/10 px-3 text-sm text-white">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Price ($)</label>
                        <input type="number" step="0.01" name="price" id="edit-price" class="w-full h-11 bg-[#222222] border border-white/10 px-3 text-sm text-white" required>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Stock Count</label>
                        <input type="number" name="stock" id="edit-stock" class="w-full h-11 bg-[#222222] border border-white/10 px-3 text-sm text-white" required>
                    </div>
                </div>
                <label class="flex items-center gap-2 mt-2">
                    <input type="checkbox" name="active" id="edit-active" value="true" class="w-4 h-4 accent-[#f05a1a]">
                    <span class="text-xs font-bold text-neutral-100">Active Listing</span>
                </label>
                <div class="flex gap-3 mt-4">
                    <button type="submit" id="edit-submit-btn" class="flex-1 bg-[#f05a1a] hover:bg-[#d94f14] transition text-white text-xs font-bold py-3">Save Changes</button>
                    <button type="button" onclick="closeEditPanel()" class="px-5 border border-white/20 text-xs font-bold text-neutral-100">Cancel</button>
                </div>
            </form>
        </div>
    </aside>

    <div class="flex">
        <aside class="w-56 shrink-0 border-r border-white/10 min-h-[calc(100vh-105px)] px-4 py-6">
            <a href="/Admin/Dashboard" class="flex items-center gap-2 px-3 py-2.5 text-[#888888] hover:text-white transition text-xs font-bold">📊 Overview</a>
            <a href="/Admin/Products" class="flex items-center gap-2 px-3 py-2.5 mt-1 bg-[#f05a1a] text-white text-xs font-bold">📦 Products</a>
            <a href="/Admin/Orders" class="flex items-center gap-2 px-3 py-2.5 mt-1 text-[#888888] hover:text-white transition text-xs font-bold">🧾 Orders</a>
            <a href="/Home" class="flex items-center gap-2 px-3 py-2.5 mt-8 border-t border-white/10 pt-4 text-[#888888] hover:text-white transition text-xs font-bold">← Exit Admin</a>
        </aside>

        <main class="flex-1 px-8 py-8">
            <div class="flex justify-between items-center">
                <span class="text-xs text-[#888888]">@Model.Products.Count products</span>
                <button type="button" onclick="openEditPanel(0, 'New Product', '', 0.00, 0, true, '')" class="bg-[#f05a1a] hover:bg-[#d94f14] transition text-white text-[10px] font-bold px-4 py-2.5">+ Add Product</button>
            </div>

            <div class="border border-white/10 mt-4 overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="bg-[#161616] text-[#888888]">
                            <th class="px-4 py-3 font-bold">Product</th>
                            <th class="px-4 py-3 font-bold">Category</th>
                            <th class="px-4 py-3 font-bold">Price</th>
                            <th class="px-4 py-3 font-bold">Stock</th>
                            <th class="px-4 py-3 font-bold">Status</th>
                            <th class="px-4 py-3 font-bold">Tag</th>
                            <th class="px-4 py-3 font-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Products)
                        {
                            <tr class="border-t border-white/10">
                                <td class="px-4 py-3 flex items-center gap-3">
                                    <div class="w-8 h-8 bg-[#1a1a1a] flex items-center justify-center overflow-hidden border border-white/5 shrink-0">
                                        <img src="@p.ImageUrl" class="max-w-full max-h-full object-contain" alt="">
                                    </div>
                                    <div>
                                        <span class="block font-bold text-neutral-100">@p.Name</span>
                                        <span class="block text-[10px] text-[#888888]">@p.Variant</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-[#888888]">@p.Category</td>
                                <td class="px-4 py-3 font-bold text-[#f05a1a]">$@p.Price.ToString("0")</td>
                                <td class="px-4 py-3 text-neutral-100">@p.Stock</td>
                                <td class="px-4 py-3">
                                    <span class="text-[9px] font-bold px-2 py-1 @(p.Active ? "bg-green-500/10 text-green-400" : "bg-[#333333] text-[#888888]")">@(p.Active ? "Active" : "Inactive")</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="text-[9px] font-bold px-2 py-1 text-white" style="background-color:@p.TagColorHex;">@p.Tag</span>
                                </td>
                                <td class="px-4 py-3">
                                    <button onclick="openEditPanel(@p.Id, '@p.Name', '@p.Variant', @p.Price, @p.Stock, @p.Active.ToString().ToLower(), '@p.ImageUrl')"
                                            class="text-[#888888] hover:text-white transition mr-2">
                                        ✏️
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="inline" onsubmit="return confirm('Delete this product permanently?');">
                                        <button type="submit" class="text-[#888888] hover:text-red-400 transition">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script>
        function toggleAdminDrawer() {
            document.getElementById('admin-drawer').classList.toggle('open');
            document.getElementById('admin-drawer-overlay').classList.toggle('open');
        }

        function previewAndValidateFile(input) {
            const warningEl = document.getElementById('file-size-warning');
            const submitBtn = document.getElementById('edit-submit-btn');
            
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const maxSizeInBytes = 2 * 1024 * 1024; // 2MB Limit

                if (file.size > maxSizeInBytes) {
                    warningEl.classList.remove('hidden');
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-40', 'cursor-not-allowed');
                    return;
                } else {
                    warningEl.classList.add('hidden');
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-40', 'cursor-not-allowed');
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('edit-image-preview').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function openEditPanel(id, name, variant, price, stock, active, image) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-variant').value = variant;
            document.getElementById('edit-price').value = price;
            document.getElementById('edit-stock').value = stock;
            document.getElementById('edit-active').checked = active;
            document.getElementById('edit-imageUrl').value = image;
            
            // Handle display logic if no image exists yet
            document.getElementById('edit-image-preview').src = image || '/images/Grace_Threads_Logo_white_1.png';
            
            // Reset files picker and warnings from previous actions
            document.getElementById('edit-imageFile').value = "";
            document.getElementById('file-size-warning').class={};
            document.getElementById('file-size-warning').classList.add('hidden');
            document.getElementById('edit-submit-btn').disabled = false;
            document.getElementById('edit-submit-btn').classList.remove('opacity-40', 'cursor-not-allowed');

            document.getElementById('edit-panel-title').textContent = id === 0 ? "Add New Product" : "Edit Product";
            
            document.getElementById('edit-panel').classList.add('open');
            document.getElementById('edit-overlay').classList.add('open');
        }

        function closeEditPanel() {
            document.getElementById('edit-panel').classList.remove('open');
            document.getElementById('edit-overlay').classList.remove('open');
        }
    </script>

</body>
</html>