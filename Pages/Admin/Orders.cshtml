@page
@model GraceThreads.Pages.Admin.OrdersModel
@using GraceThreads.Services
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grace Threads — Admin Orders</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        }

        body {
        background: #0c0c0c;
        }

        #admin-drawer {
        transform: translateX(100%);
        transition: transform 0.3s ease;
        }

        #admin-drawer.open {
        transform: translateX(0);
        }

        #admin-drawer-overlay {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        }

        #admin-drawer-overlay.open {
        opacity: 1;
        pointer-events: auto;
        }
    </style>
</head>
<body class="bg-[#0c0c0c] text-white">

    <div class="bg-[#f05a1a] text-white text-center py-2.5 px-4">
        <span class="text-[11px] font-bold tracking-wide">Free Shipping on All Orders Over $60 · Ephesians 2:8</span>
    </div>

    <header class="border-b border-white/10">
        <div class="max-w-7xl mx-auto h-16 flex items-center justify-between px-6">
            <a href="/Admin/Dashboard" class="flex items-center gap-3">
                <div class="w-[34px] h-[34px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-6 h-6 object-contain">
                </div>
                <div class="leading-tight">
                    <div class="font-black text-lg text-neutral-100">Grace Threads</div>
                    <div class="font-medium text-[9px] text-[#888888] tracking-wide">Admin</div>
                </div>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                <a href="/Home" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Home</a>
                <a href="/Catalog" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Shop</a>
            </nav>
            <div class="flex items-center gap-3">
                <a href="/Admin/Dashboard" class="border border-white/20 text-[10px] font-bold text-neutral-100 px-3 py-1.5">📊 Dashboard</a>
                <button onclick="toggleAdminDrawer()" class="w-8 h-8 rounded-full bg-[#f05a1a] flex items-center justify-center">
                    <span class="text-xs font-black text-white">A</span>
                </button>
            </div>
        </div>
    </header>

    <partial name="_AdminAccountDrawer" />

    <div class="flex">
        <aside class="w-56 shrink-0 border-r border-white/10 min-h-[calc(100vh-105px)] px-4 py-6">
            <a href="/Admin/Dashboard" class="flex items-center gap-2 px-3 py-2.5 text-[#888888] hover:text-white transition text-xs font-bold">📊 Overview</a>
            <a href="/Admin/Products" class="flex items-center gap-2 px-3 py-2.5 mt-1 text-[#888888] hover:text-white transition text-xs font-bold">📦 Products</a>
            <a href="/Admin/Orders" class="flex items-center gap-2 px-3 py-2.5 mt-1 bg-[#f05a1a] text-white text-xs font-bold">🧾 Orders</a>
            <a href="/Home" class="flex items-center gap-2 px-3 py-2.5 mt-8 border-t border-white/10 pt-4 text-[#888888] hover:text-white transition text-xs font-bold">← Exit Admin</a>
        </aside>

        <main class="flex-1 px-8 py-8">
            <span class="text-xs text-[#888888]">@AdminDataService.Orders.Count orders</span>

            <div class="border border-white/10 mt-4 overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="bg-[#161616] text-[#888888]">
                            <th class="px-4 py-3 font-bold">Order ID</th>
                            <th class="px-4 py-3 font-bold">Customer</th>
                            <th class="px-4 py-3 font-bold">Item</th>
                            <th class="px-4 py-3 font-bold">Date</th>
                            <th class="px-4 py-3 font-bold">Status</th>
                            <th class="px-4 py-3 font-bold">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in AdminDataService.Orders)
                        {
                            <tr class="border-t border-white/10">
                                <td class="px-4 py-3 font-bold text-neutral-100">@o.OrderId</td>
                                <td class="px-4 py-3 text-neutral-100">@o.Customer</td>
                                <td class="px-4 py-3 text-[#888888]">@o.Item</td>
                                <td class="px-4 py-3 text-[#888888]">@o.Date.ToString("MMM d, yyyy")</td>
                                <td class="px-4 py-3">
                                    <span class="text-[9px] font-bold px-2 py-1 @(o.Status == "Delivered" ? "bg-green-500/10 text-green-400" : o.Status == "Shipped" ? "bg-blue-500/10 text-blue-400" : "bg-[#f05a1a]/10 text-[#f05a1a]")">@o.Status</span>
                                </td>
                                <td class="px-4 py-3 font-bold text-[#f05a1a]">$@o.Total.ToString("0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script>
        function toggleAdminDrawer() {
        document.getElementById('admin-drawer').classList.toggle('open');
        document.getElementById('admin-drawer-overlay').classList.toggle('open');
        }
    </script>

</body>
</html>