@page
@model GraceThreads.Pages.Admin.DevCheckCredentialsModel
@{
    ViewData["Title"] = "Dev Check Credentials";
}

<div class="max-w-xl mx-auto p-6 bg-white rounded shadow">
    <h2 class="text-xl font-bold mb-4">Development: Check Stored Admin Hash</h2>
    <form method="post">
        <label class="block text-sm font-medium">Email</label>
        <input asp-for="Email" class="mt-1 block w-full border rounded px-2 py-1" />
        <label class="block text-sm font-medium mt-2">Password to verify</label>
        <input asp-for="Password" class="mt-1 block w-full border rounded px-2 py-1" />
        <div class="mt-4">
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Check</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ResultMessage))
    {
        <pre class="mt-4 bg-gray-100 p-4 text-xs text-black">@Model.ResultMessage</pre>
    }
</div>