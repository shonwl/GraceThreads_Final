@page
@model GraceThreads.Pages.ContactModel
@using GraceThreads.Models
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grace Threads — Contact Us</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        }

        body {
        background: #0c0c0c;
        }

        input::placeholder, textarea::placeholder {
        color: #666;
        }

        input:focus, textarea:focus {
        outline: none;
        border-color: #f05a1a;
        }

        #cart-panel {
        transform: translateX(100%);
        transition: transform 0.3s ease;
        }

        #cart-panel.open {
        transform: translateX(0);
        }

        #cart-overlay {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        }

        #cart-overlay.open {
        opacity: 1;
        pointer-events: auto;
        }

        #search-bar {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.25s ease;
        }

        #search-bar.open {
        max-height: 80px;
        }
    </style>
</head>
<body class="bg-[#0c0c0c] text-white">

    <!-- Promo bar -->
    <div class="bg-[#f05a1a] text-white text-center py-2.5 px-4">
        <span class="text-[11px] font-bold tracking-wide">Free Shipping on All Orders Over ₱1000 · Ephesians 2:8</span>
    </div>

    <!-- Nav -->
    <header class="border-b border-white/10 relative">
        <div class="max-w-7xl mx-auto h-16 flex items-center justify-between px-6">
            <a href="/Home" class="flex items-center gap-3">
                <div class="w-[34px] h-[34px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-6 h-6 object-contain">
                </div>
                <div class="leading-tight">
                    <div class="font-black text-lg text-neutral-100">Grace Threads</div>
                    <div class="font-medium text-[9px] text-[#888888] tracking-wide">We Wear What We Believe</div>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8">
                <a href="/Home" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Home</a>
                <a href="/Catalog" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Shop</a>
                <a href="/Contact" class="text-[11px] font-bold text-[#f05a1a]">Contact</a>
            </nav>

            <div class="flex items-center gap-5">
                <button aria-label="Search" onclick="toggleSearch()">
                    <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="#cccccc" stroke-width="2">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
                    </svg>
                </button>
                <button aria-label="Cart" onclick="toggleCart()">
                    <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="#cccccc" stroke-width="2">
                        <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round" />
                        <path d="M6 6L5 3H2" stroke-linecap="round" />
                        <circle cx="9" cy="20" r="1" fill="#cccccc" />
                        <circle cx="18" cy="20" r="1" fill="#cccccc" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Search bar -->
        <div id="search-bar" class="border-t border-white/10 bg-[#0c0c0c]">
            <div class="max-w-7xl mx-auto px-6 py-4 flex items-center gap-3">
                <svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0" fill="none" stroke="#888888" stroke-width="2">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
                </svg>
                <input type="text" placeholder="Search products..."
                       class="flex-1 bg-transparent text-sm text-white placeholder:text-[#888888] focus:outline-none">
                <button aria-label="Close search" onclick="toggleSearch()">
                    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#888888" stroke-width="2">
                        <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" />
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Cart overlay + panel -->
    <partial name="_CartPanel" model="Model.CartItems" />
    <!-- Contact -->
    <section class="px-6 py-16">
        <div class="max-w-5xl mx-auto">
            <span class="block text-[11px] font-bold text-[#f05a1a]">Get In Touch</span>
            <h1 class="font-black text-5xl md:text-6xl text-neutral-100 mt-2">Contact Us</h1>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="mt-6 bg-green-500/10 border border-green-500/30 text-green-400 text-xs px-4 py-3 max-w-xl">
                    @Model.SuccessMessage
                </div>
            }

            <div class="grid md:grid-cols-2 gap-12 mt-12">
                <!-- Left: info -->
                <div>
                    <p class="text-sm text-[#888888] leading-relaxed">
                        Have a question about your order, a collab idea, or just want to connect? We typically respond within 24–48 hours.
                    </p>

                    <div class="flex items-center gap-4 mt-10">
                        <div class="w-10 h-10 flex items-center justify-center bg-[#1a1a1a] border border-white/10 shrink-0">
                            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#f05a1a" stroke-width="2">
                                <rect x="2" y="2" width="20" height="20" rx="5" />
                                <circle cx="12" cy="12" r="4.5" />
                                <circle cx="17.5" cy="6.5" r="1" fill="#f05a1a" />
                            </svg>
                        </div>
                        <div>
                            <span class="block text-[10px] text-[#888888]">Instagram</span>
                            <span class="block font-semibold text-sm text-neutral-100 mt-0.5">@@gracethreadsofficial</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 mt-6">
                        <div class="w-10 h-10 flex items-center justify-center bg-[#1a1a1a] border border-white/10 shrink-0">
                            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#f05a1a" stroke-width="2">
                                <path d="M15 3h-2a5 5 0 0 0-5 5v2H6v4h2v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div>
                            <span class="block text-[10px] text-[#888888]">Facebook</span>
                            <span class="block font-semibold text-sm text-neutral-100 mt-0.5">Grace Threads and more</span>
                        </div>
                    </div>

                    <div class="w-32 mt-10">
                        <img src="/images/HEM.png" alt="Grace Threads — We Wear What We Believe" class="w-full h-auto object-contain">
                    </div>
                </div>

                <!-- Right: form -->
                <form method="post" class="flex flex-col gap-4">
                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Full Name</label>
                        <input asp-for="Input.FullName" placeholder="John Grace"
                               class="w-full h-[46px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.FullName" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Email</label>
                        <input asp-for="Input.Email" placeholder="you@example.com"
                               class="w-full h-[46px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.Email" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Subject</label>
                        <input asp-for="Input.Subject" placeholder="Order, collab, etc."
                               class="w-full h-[46px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.Subject" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Message</label>
                        <textarea asp-for="Input.Message" rows="5" placeholder="How can we help?"
                                  class="w-full bg-[#222222] border border-white/10 px-4 py-3 text-sm text-white placeholder:text-[#666666] resize-none"></textarea>
                        <span asp-validation-for="Input.Message" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <button type="submit"
                            class="flex justify-center items-center gap-2 bg-[#f05a1a] hover:bg-[#d94f14] transition text-white font-black text-[11px] py-4 mt-2">
                        Send Message →
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Newsletter -->
    <section class="bg-[#1a1a1a] px-6 py-20">
        <div class="max-w-[512px] mx-auto flex flex-col items-center text-center">
            <span class="text-[11px] font-bold text-[#f05a1a] tracking-wide">Join The Movement</span>
            <h2 class="font-black text-3xl text-neutral-100 mt-3">Early Access to Every Drop</h2>
            <p class="text-sm text-[#888888] mt-4">Be first for new releases, restocks, and exclusive Grace Threads content.</p>
            <div class="flex w-full max-w-sm mt-8">
                <input type="email" placeholder="your@email.com" class="flex-1 h-12 bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                <button class="bg-[#f05a1a] hover:bg-[#d94f14] transition text-white text-[11px] font-black px-7">Subscribe</button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#161616] border-t border-white/10 px-6 pt-14 pb-8">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-[30px] h-[30px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center">
                            <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="#f05a1a" stroke-width="2"><path d="M12 2v20M4 8h16" stroke-linecap="round" /></svg>
                        </div>
                        <span class="font-black text-base text-neutral-100">Grace Threads</span>
                    </div>
                    <p class="text-[12px] text-[#888888] leading-[19.5px] mt-5">Faith. Style. Grace.<br>We wear what we believe.</p>
                </div>
                <div>
                    <h3 class="text-[11px] font-bold text-neutral-100">Shop</h3>
                    <ul class="flex flex-col gap-2.5 mt-4 text-xs font-medium text-[#888888]">
                        <li><a href="/Catalog" class="hover:text-white transition">All Products</a></li>
                        <li><a href="/Catalog" class="hover:text-white transition">Saved By Grace Tee</a></li>
                        <li><a href="/Catalog" class="hover:text-white transition">Hoodies</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-[11px] font-bold text-neutral-100">Help</h3>
                    <ul class="flex flex-col gap-2.5 mt-4 text-xs font-medium text-[#888888]">
                        <li><a href="/Contact" class="hover:text-white transition">Contact Us</a></li>
                        <li><a href="#" class="hover:text-white transition">Size Guide</a></li>
                        <li><a href="#" class="hover:text-white transition">FAQ</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-[11px] font-bold text-neutral-100">Connect</h3>
                    <ul class="flex flex-col gap-2.5 mt-4 text-xs font-normal text-[#888888]">
                        <li><a href="#" class="hover:text-white transition">Instagram</a></li>
                        <li><a href="#" class="hover:text-white transition">Facebook</a></li>
                    </ul>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6 mt-12 border-t border-white/10">
                <span class="text-xs text-[#888888]">© 2025 Grace Threads. All rights reserved.</span>
                <span class="text-[10px] font-bold text-[#f05a1a]">Ephesians 2:8</span>
            </div>
        </div>
    </footer>

    <script>
        function toggleCart() {
        document.getElementById('cart-panel').classList.toggle('open');
        document.getElementById('cart-overlay').classList.toggle('open');
        }
        function toggleSearch() {
        document.getElementById('search-bar').classList.toggle('open');
        }
    </script>

</body>
</html>