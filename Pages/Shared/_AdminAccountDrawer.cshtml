<div id="admin-drawer-overlay" class="fixed inset-0 bg-black/60 z-40" onclick="toggleAdminDrawer()"></div>
<aside id="admin-drawer" class="fixed top-0 right-0 h-full w-full max-w-[340px] bg-[#161616] z-50 flex flex-col border-l border-white/10">
    <div class="px-6 py-6 border-b border-white/10">
        <div class="w-14 h-14 rounded-full bg-[#f05a1a] flex items-center justify-center mx-auto">
            <span class="font-black text-xl text-white">A</span>
        </div>
        <div class="text-center mt-3">
            <span class="block font-black text-sm text-neutral-100">Admin User</span>
            <span class="inline-block mt-1 text-[9px] font-bold text-green-400 bg-green-500/10 px-2 py-1">● Active</span>
        </div>
    </div>
    <div class="px-6 py-5 flex flex-col gap-4 border-b border-white/10">
        <div>
            <span class="block text-[10px] text-[#888888]">Role</span>
            <span class="block text-sm text-neutral-100 mt-0.5">Administrator</span>
        </div>
        <div>
            <span class="block text-[10px] text-[#888888]">Store</span>
            <span class="block text-sm text-neutral-100 mt-0.5">Grace Threads</span>
        </div>
        <div>
            <span class="block text-[10px] text-[#888888]">Last Login</span>
            <span class="block text-sm text-neutral-100 mt-0.5">@DateTime.Now.ToString("MMM d, yyyy")</span>
        </div>
    </div>
    <div class="px-6 py-5 flex flex-col gap-3">
        <button type="button" class="border border-white/20 text-neutral-100 text-xs font-bold py-3 hover:border-white transition">Edit Profile</button>
        <form method="post" asp-page="/Admin/SignOut">
            <button type="submit" class="w-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold py-3 hover:bg-red-500/20 transition">Sign Out</button>
        </form>
    </div>
</aside>