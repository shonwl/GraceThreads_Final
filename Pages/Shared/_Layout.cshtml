<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GraceThreads</title>
    
    <!-- Tailwind and Fonts for the UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GraceThreads.styles.css" asp-append-version="true" />
</head>
<body class="bg-[#0c0c0c] text-white">

    <!-- This is where your individual pages (Home, Catalog, Product) will load -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 1. The Global Chat Overlay & Panel -->
    <div id="chat-overlay" class="fixed inset-0 bg-black/60 z-40 opacity-0 pointer-events-none transition-opacity duration-200" onclick="toggleChat()"></div>
    
    <aside id="chat-panel" class="fixed top-0 right-0 h-full w-full max-w-[448px] bg-[#161616] z-50 flex flex-col border-l border-white/10 translate-x-full transition-transform duration-300">
        <div class="flex justify-between items-center px-6 py-5 border-b border-white/10">
            <div class="flex items-center gap-2">
                <img src="/images/Grace_Threads_Logo_white_1.png" alt="" class="w-[18px] h-[18px] object-contain">
                <span class="font-black text-sm text-neutral-100">Ask A Question</span>
            </div>
            <button aria-label="Close chat" onclick="toggleChat()">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="#888888" stroke-width="2">
                    <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" />
                </svg>
            </button>
        </div>

        <div id="chat-messages" class="flex-1 overflow-y-auto px-6 py-6 flex flex-col gap-4">
            <div class="flex flex-col items-center justify-center gap-4 h-full text-center">
                <div class="w-10 h-10 rounded-full bg-[#f05a1a]/10 flex items-center justify-center">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="" class="w-5 h-5 object-contain">
                </div>
                <span class="text-sm font-bold text-neutral-100">Got a question about sizing, fabric, or fit?</span>
                <span class="text-xs text-[#888888] max-w-[280px]">Ask below and we'll get you an answer.</span>
            </div>
        </div>

        <form id="chat-form" class="flex items-center gap-2 px-4 py-4 border-t border-white/10" onsubmit="sendChatMessage(event)">
            <input type="text" id="chat-input" placeholder="Ask a question..." autocomplete="off"
                   class="flex-1 h-11 bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666] focus:outline-none focus:border-[#f05a1a]">
            <button type="submit" aria-label="Send" class="w-11 h-11 flex items-center justify-center bg-[#f05a1a] hover:bg-[#d94f14] transition shrink-0">
                <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="white" stroke-width="2">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </form>
    </aside>

    <!-- 2. The Floating Widget Container -->
    <div id="chat-widget-container" class="fixed bottom-6 right-6 z-50 flex items-center gap-3 transition-opacity duration-300">
        <!-- Text Prompt Indicator -->
        <div class="bg-white text-black text-xs font-bold py-2 px-3 rounded shadow-lg relative animate-bounce cursor-pointer" onclick="toggleChat()">
            Need sizing help?
            <div class="absolute top-1/2 -right-1 -mt-1 w-2 h-2 bg-white rotate-45"></div>
        </div>

        <!-- Floating Trigger Button -->
        <div class="relative">
            <span class="absolute -top-1 -right-1 flex h-3 w-3 z-50">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
            </span>
            
            <button aria-label="Open chat" onclick="toggleChat()" 
                    class="w-14 h-14 bg-[#f05a1a] hover:bg-[#d94f14] text-white rounded-full flex items-center justify-center shadow-[0_8px_30px_rgb(240,90,26,0.2)] transition-all duration-300 hover:scale-110 active:scale-95 group border border-white/10">
                <img src="/images/Grace_Threads_Logo_white_1.png" alt="Ask a question" class="w-6 h-6 object-contain transition-transform duration-300 group-hover:rotate-12">
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>