@page
@model GraceThreads.Pages.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grace Threads — Create Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        }

        body {
        background: #0c0c0c;
        }

        input::placeholder {
        color: #666;
        }

        input:focus {
        outline: none;
        border-color: #f05a1a;
        }
    </style>
</head>
<body class="bg-[#0c0c0c] text-white">

    <!-- Promo bar -->
    <div class="bg-[#f05a1a] text-white text-center py-2.5 px-4">
        <span class="text-[11px] font-bold tracking-wide">Free Shipping on All Orders Over $60 · Ephesians 2:8</span>
    </div>

    <!-- Nav -->
    <header class="border-b border-white/10">
        <div class="max-w-7xl mx-auto h-16 flex items-center justify-between px-6">
            <a href="/" class="flex items-center gap-3">
                <div class="w-[34px] h-[34px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-6 h-6 object-contain">
                </div>
                <div class="leading-tight">
                    <div class="font-black text-lg text-neutral-100">Grace Threads</div>
                    <div class="font-medium text-[9px] text-[#888888] tracking-wide">We Wear What We Believe</div>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8">
                <a href="/" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Home</a>
                <a href="#" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Shop</a>
                <a href="#" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Contact</a>
                <a href="/" class="text-[11px] font-bold text-[#f05a1a]">Login</a>
            </nav>

            <div class="flex items-center gap-5">
                <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="#cccccc" stroke-width="2">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
                </svg>
                <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="#cccccc" stroke-width="2">
                    <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round" />
                    <path d="M6 6L5 3H2" stroke-linecap="round" />
                    <circle cx="9" cy="20" r="1" fill="#cccccc" />
                    <circle cx="18" cy="20" r="1" fill="#cccccc" />
                </svg>
            </div>
        </div>
    </header>

    <!-- Register -->
    <main class="relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(240,90,26,0.08),transparent_60%)]"></div>
        <div class="relative flex flex-col items-center px-6 py-16">

            <div class="flex flex-col items-center gap-2 mb-6">
                <div class="w-14 h-14 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-9 h-9 object-contain">
                </div>
                <span class="font-black text-xl text-neutral-100">Grace Threads</span>
                <span class="font-medium text-[10px] text-[#888888] tracking-wide">We Wear What We Believe</span>
            </div>

            <div class="w-full max-w-[446px] bg-[#161616] border border-white/10 p-10">
                <span class="block text-[11px] font-bold text-[#f05a1a] tracking-wide">Join The Family</span>
                <h1 class="font-black text-2xl text-neutral-100 mt-1">Create Account</h1>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="mt-4 bg-red-500/10 border border-red-500/30 text-red-400 text-xs px-4 py-3">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post" class="flex flex-col gap-5 mt-8">
                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Full Name</label>
                        <input asp-for="Input.FullName" placeholder="John Grace"
                               class="w-full h-[50px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.FullName" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Email Address</label>
                        <input asp-for="Input.Email" placeholder="you@example.com"
                               class="w-full h-[50px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.Email" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Password</label>
                        <input asp-for="Input.Password" placeholder="Min. 8 characters"
                               class="w-full h-[50px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.Password" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#888888] mb-1.5">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" placeholder="Repeat password"
                               class="w-full h-[50px] bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                        <span asp-validation-for="Input.ConfirmPassword" class="block text-[10px] text-red-400 mt-1"></span>
                    </div>

                    <button type="submit"
                            class="w-full bg-[#f05a1a] hover:bg-[#d94f14] transition text-white font-black text-sm py-4 mt-1">
                        Create Account
                    </button>
                </form>

                <div class="flex items-center gap-3 mt-6">
                    <div class="h-px bg-white/10 flex-1"></div>
                    <span class="text-[10px] text-[#888888]">or</span>
                    <div class="h-px bg-white/10 flex-1"></div>
                </div>

             

                <div class="text-center mt-6 text-sm">
                    <span class="text-[#888888]">Already have an account? </span>
                    <a href="/" class="font-bold text-[#f05a1a]">Sign in</a>
                </div>
            </div>

            <a href="/" class="text-[10px] font-medium text-[#888888] mt-6 hover:text-white transition">← Back to Home</a>
        </div>
    </main>

    <!-- Newsletter -->
    <section class="bg-[#1a1a1a] px-6 py-20">
        <div class="max-w-[512px] mx-auto flex flex-col items-center text-center">
            <span class="text-[11px] font-bold text-[#f05a1a] tracking-wide">Join The Movement</span>
            <h2 class="font-black text-3xl text-neutral-100 mt-3">Early Access to Every Drop</h2>
            <p class="text-sm text-[#888888] mt-4">Be first for new releases, restocks, and exclusive Grace Threads content.</p>
            <div class="flex w-full max-w-sm mt-8">
                <input type="email" placeholder="you@email.com" class="flex-1 h-11 bg-[#222222] border border-white/10 px-4 text-sm text-white placeholder:text-[#666666]">
                <button class="bg-[#f05a1a] text-white text-xs font-black px-5">SUBSCRIBE</button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#161616] border-t border-white/10 px-6 pt-14 pb-8">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
                <div>
                    <div class="flex items-center gap-3">
                        <div class="w-[30px] h-[30px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                            <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-5 h-5 object-contain">
                        </div>
                        <span class="font-black text-base text-neutral-100">Grace Threads</span>
                    </div>
                    <p class="text-[12px] text-[#888888] leading-[19.5px] mt-5">Faith. Style. Grace.<br>We wear what we believe.</p>
                </div>
                <div>
                    <h3 class="text-[11px] font-bold text-neutral-100">Shop</h3>
                    <ul class="flex flex-col gap-2.5 mt-4 text-xs font-medium text-[#888888]">
                        <li><a href="#" class="hover:text-white transition">All Products</a></li>
                        <li><a href="#" class="hover:text-white transition">Saved By Grace Tee</a></li>
                        <li><a href="#" class="hover:text-white transition">Hoodies</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-[11px] font-bold text-neutral-100">Help</h3>
                    <ul class="flex flex-col gap-2.5 mt-4 text-xs font-medium text-[#888888]">
                        <li><a href="#" class="hover:text-white transition">Contact Us</a></li>
                        <li><a href="#" class="hover:text-white transition">Size Guide</a></li>
                        <li><a href="#" class="hover:text-white transition">FAQ</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-[11px] font-bold text-neutral-100">Connect</h3>
                    <ul class="flex flex-col gap-2.5 mt-4 text-xs font-normal text-[#888888]">
                        <li><a href="#" class="hover:text-white transition">Instagram</a></li>
                        <li><a href="#" class="hover:text-white transition">Facebook</a></li>
                    </ul>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6 mt-12 border-t border-white/10">
                <span class="text-xs text-[#888888]">© 2025 Grace Threads. All rights reserved.</span>
                <span class="text-[10px] font-bold text-[#f05a1a]">Ephesians 2:8</span>
            </div>
        </div>
    </footer>

</body>
</html>