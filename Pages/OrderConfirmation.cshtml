@page
@model GraceThreads.Pages.OrderConfirmationModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grace Threads — Order Confirmed</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        }

        body {
        background: #0c0c0c;
        }
    </style>
</head>
<body class="bg-[#0c0c0c] text-white">

    <!-- Promo bar -->
    <div class="bg-[#f05a1a] text-white text-center py-2.5 px-4">
        <span class="text-[11px] font-bold tracking-wide">Free Shipping on All Orders Over $60 · Ephesians 2:8</span>
    </div>

    <!-- Nav -->
    <header class="border-b border-white/10">
        <div class="max-w-7xl mx-auto h-16 flex items-center justify-between px-6">
            <a href="/Home" class="flex items-center gap-3">
                <div class="w-[34px] h-[34px] rounded-sm bg-[#1c1c1c] border border-white/10 flex items-center justify-center overflow-hidden">
                    <img src="/images/Grace_Threads_Logo_white_1.png" alt="Grace Threads logo" class="w-6 h-6 object-contain">
                </div>
                <div class="leading-tight">
                    <div class="font-black text-lg text-neutral-100">Grace Threads</div>
                    <div class="font-medium text-[9px] text-[#888888] tracking-wide">We Wear What We Believe</div>
                </div>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                <a href="/Home" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Home</a>
                <a href="/Catalog" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Shop</a>
                <a href="/Contact" class="text-[11px] font-medium text-[#888888] hover:text-white transition">Contact</a>
            </nav>
        </div>
    </header>

    <!-- Confirmation -->
    <section class="px-6 py-20">
        <div class="max-w-2xl mx-auto text-center">
            <div class="w-16 h-16 rounded-full bg-green-500/10 flex items-center justify-center mx-auto">
                <svg viewBox="0 0 24 24" class="w-8 h-8" fill="none" stroke="#4ade80" stroke-width="2.5">
                    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <span class="block text-[11px] font-bold text-[#f05a1a] mt-6">Order Confirmed</span>
            <h1 class="font-black text-4xl md:text-5xl text-neutral-100 mt-3">Thank you, @Model.FullName.Split(' ')[0]!</h1>
            <p class="text-sm text-[#888888] mt-4">
                Your order <span class="text-neutral-100 font-bold">@Model.OrderId</span> has been placed. A confirmation has been sent to <span class="text-neutral-100">@Model.Email</span>.
            </p>
        </div>

        <div class="max-w-2xl mx-auto mt-12 border border-white/10 bg-[#161616]">
            <div class="p-6 border-b border-white/10">
                <span class="text-[11px] font-bold text-[#f05a1a] tracking-wide">Order Details</span>
                <div class="grid grid-cols-2 gap-4 mt-4 text-xs">
                    <div>
                        <span class="block text-[#888888]">Order ID</span>
                        <span class="block text-neutral-100 font-bold mt-0.5">@Model.OrderId</span>
                    </div>
                    <div>
                        <span class="block text-[#888888]">Order Date</span>
                        <span class="block text-neutral-100 font-bold mt-0.5">@DateTime.Now.ToString("MMM d, yyyy")</span>
                    </div>
                    <div class="col-span-2">
                        <span class="block text-[#888888]">Shipping To</span>
                        <span class="block text-neutral-100 font-bold mt-0.5">@Model.FullName</span>
                        <span class="block text-[#888888] mt-0.5">@Model.Address, @Model.City @Model.PostalCode</span>
                    </div>
                </div>
            </div>

            <div class="p-6 flex flex-col gap-4">
                @foreach (var item in Model.CartItems)
                {
                    <div class="flex items-center gap-4 border-b border-white/10 pb-4">
                        <div class="w-16 h-16 shrink-0 bg-[#1a1a1a] flex items-center justify-center overflow-hidden">
                            <img src="@item.ImageUrl" alt="@item.ProductName" class="w-full h-full object-contain p-1">
                        </div>
                        <div class="flex-1 text-left">
                            <span class="block text-sm font-bold text-neutral-100">@item.ProductName</span>
                            <span class="block text-[10px] text-[#888888] mt-0.5">@item.Variant</span>
                            <span class="block text-[10px] text-[#888888] mt-0.5">Qty: @item.Quantity</span>
                        </div>
                        <span class="text-sm font-bold text-[#f05a1a]">$@((item.Price * item.Quantity).ToString("0.00"))</span>
                    </div>
                }

                <div class="flex justify-between text-xs text-[#888888]">
                    <span>Subtotal</span>
                    <span class="text-neutral-100">$@Model.Subtotal.ToString("0.00")</span>
                </div>
                <div class="flex justify-between text-xs text-[#888888]">
                    <span>Shipping</span>
                    <span class="text-neutral-100">@(Model.Shipping == 0 ? "Free" : "$" + Model.Shipping.ToString("0.00"))</span>
                </div>
                <div class="flex justify-between text-base font-black border-t border-white/10 pt-3">
                    <span class="text-neutral-100">Total</span>
                    <span class="text-[#f05a1a]">$@Model.Total.ToString("0.00")</span>
                </div>
            </div>
        </div>

        <div class="max-w-2xl mx-auto flex justify-center gap-4 mt-10">
            <a href="/Catalog" class="bg-[#f05a1a] hover:bg-[#d94f14] transition text-white text-xs font-black px-8 py-4">
                Continue Shopping
            </a>
            <a href="/Home" class="border border-white/20 hover:border-white transition text-neutral-100 text-xs font-bold px-8 py-4">
                Back to Home
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#161616] border-t border-white/10 px-6 py-8 text-center mt-10">
        <span class="text-xs text-[#888888]">© 2025 Grace Threads. All rights reserved.</span>
        <span class="block text-[10px] font-bold text-[#f05a1a] mt-1">Ephesians 2:8</span>
    </footer>

</body>
</html>